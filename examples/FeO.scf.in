&control
  prefix = 'FeO_manual_id_144'
  verbosity = 'high'
  calculation = 'scf'
  outdir = './outputs'
  pseudo_dir = '.'
  restart_mode = 'from_scratch'
/

&system
  ibrav = 0
  nat = 4
  ntyp = 3
  starting_magnetization(1) = 1.0e-5
  starting_magnetization(2) = 1.0e-5
  nspin = 2
  ecutwfc = 60.0
  ecutrho = 480.0
  occupations = 'smearing'
  smearing = 'mv'
  nbnd = 50
  degauss = 0.01
/

&electrons
  mixing_beta = 0.3
  electron_maxstep = 500
  conv_thr = 1.0e-10
  mixing_mode = 'local-TF'
/

